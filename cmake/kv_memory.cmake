# Optional native source overlay. Keeping the original files in place makes
# the default CUDA/HIP/SYCL targets use exactly their upstream source lists.
if(NOT STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP OR STRATA_ENABLE_SYCL OR STRATA_HIP_GFX906)
  message(FATAL_ERROR "KV memory currently requires the single-GPU CUDA backend")
endif()
foreach(_kv_target strata strata_engine strata_prefill strata_kernels)
  if(NOT TARGET ${_kv_target})
    message(FATAL_ERROR "KV memory requires target ${_kv_target}")
  endif()
endforeach()
set(_kv_native "${CMAKE_SOURCE_DIR}/experimental/kv_memory/native")
function(_kv_replace target original replacement)
  get_target_property(_owner ${target} SOURCE_DIR)
  get_target_property(_sources ${target} SOURCES)
  set(_result)
  set(_count 0)
  foreach(_source IN LISTS _sources)
    if(_source MATCHES "^\\$<")
      list(APPEND _result "${_source}")
    else()
      get_filename_component(_absolute "${_source}" ABSOLUTE BASE_DIR "${_owner}")
      if(_absolute STREQUAL "${CMAKE_SOURCE_DIR}/${original}")
        list(APPEND _result "${_kv_native}/${replacement}")
        math(EXPR _count "${_count}+1")
      else()
        list(APPEND _result "${_absolute}")
      endif()
    endif()
  endforeach()
  if(NOT _count EQUAL 1)
    message(FATAL_ERROR "KV overlay expected one ${original}; got ${_count}")
  endif()
  set_property(TARGET ${target} PROPERTY SOURCES "${_result}")
endfunction()
_kv_replace(strata_engine src/core/layer.cpp layer.cpp)
_kv_replace(strata_engine src/core/verify.cpp verify.cpp)
_kv_replace(strata_prefill src/prefill/prefill.cpp prefill.cpp)
_kv_replace(strata src/program/generate.cpp generate.cpp)
_kv_replace(strata_kernels src/kernels/cuda/kv_stream.cu kv_stream.cu)
foreach(_kv_target strata_engine strata_prefill strata_kernels strata)
  target_include_directories(${_kv_target} PRIVATE "${_kv_native}"
    "${CMAKE_SOURCE_DIR}/src/core" "${CMAKE_SOURCE_DIR}/src/prefill" "${CMAKE_SOURCE_DIR}/src/program")
  target_compile_definitions(${_kv_target} PRIVATE STRATA_QSA_BLOCK_PROTO=1 STRATA_QSA_POOL_V2=1)
endforeach()
target_sources(strata_engine PRIVATE "${_kv_native}/qsa_block_store.cpp" "${_kv_native}/qsa_pool.cpp")
target_sources(strata_kernels PRIVATE "${_kv_native}/qsa_block_mask.cu" "${_kv_native}/qsa_pool.cu")
option(STRATA_BUILD_KV_MEMORY_TESTS "Build model-free KV contract tests and a CUDA parity executable" ON)
if(STRATA_BUILD_KV_MEMORY_TESTS)
  enable_testing()
  foreach(_case memory_fence geometry mtp_validity compact_layout hot_reset_contract cancel_policy)
    add_executable(kv_${_case}_test "${_kv_native}/${_case}_test.cpp")
    target_include_directories(kv_${_case}_test PRIVATE "${_kv_native}" "${CMAKE_SOURCE_DIR}/include")
    target_link_libraries(kv_${_case}_test PRIVATE CUDA::cudart)
    add_test(NAME kv_${_case}_test COMMAND kv_${_case}_test)
    set_tests_properties(kv_${_case}_test PROPERTIES LABELS "kv-memory;model-free" TIMEOUT 30)
  endforeach()
  add_executable(kv_pool_parity_test "${_kv_native}/qsa_pool_parity.cpp")
  target_include_directories(kv_pool_parity_test PRIVATE "${_kv_native}"
    "${CMAKE_SOURCE_DIR}/include" "${CMAKE_SOURCE_DIR}/src/core" "${CMAKE_SOURCE_DIR}/src/program")
  target_compile_definitions(kv_pool_parity_test PRIVATE STRATA_QSA_BLOCK_PROTO=1 STRATA_QSA_POOL_V2=1
    STRATA_NATIVE_EXPERTS=1 STRATA_Q6K_EXPERTS=1)
  target_link_libraries(kv_pool_parity_test PRIVATE strata_engine strata_kernels strata_prefill CUDA::cudart)
  # Deliberately not a CTest: running this executable consumes GPU memory.
endif()
message(STATUS "Experimental KV memory enabled; native protocol and server configuration are separately opt-in")
